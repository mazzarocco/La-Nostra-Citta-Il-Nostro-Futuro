
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/la-nostra-citta-frontend/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://la-nostra-citta-il-nostro-futuro-nh.vercel.app/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
  